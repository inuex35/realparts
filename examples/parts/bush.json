{
  "meta": {"name": "camera bush", "note": "a flanged bush that drops into the bracket bore"},
  "parameters": {"outer_d": 27.8, "inner_d": 20, "flange_d": 42, "flange_t": 5, "length": 16},
  "parameters_bounds": {"outer_d": [16, 34], "inner_d": [8, 26], "flange_d": [30, 60],
                        "flange_t": [3, 9], "length": [8, 30]},
